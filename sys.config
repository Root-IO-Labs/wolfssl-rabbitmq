%% Erlang System Configuration for FIPS Mode
%%
%% This configuration enables FIPS mode in the Erlang crypto application.
%%
%% IMPORTANT: This enables FIPS 140-3 validated cryptography through:
%%   Erlang crypto module → OpenSSL 3.x API → wolfProvider → wolfSSL FIPS v5
%%
%% All cryptographic operations will use wolfSSL FIPS v5 backend.
%%
%% NOTE: The fips_mode setting in crypto config has been removed because:
%%   1. Erlang's fips_mode is designed for OpenSSL native FIPS mode
%%   2. RabbitMQ uses wolfProvider (provider-based FIPS), not native OpenSSL FIPS
%%   3. Enabling fips_mode causes crypto NIF to fail loading (error 227)
%%   4. FIPS enforcement happens at wolfProvider level, not Erlang level
%%   5. wolfProvider is configured via openssl.cnf to use only wolfSSL FIPS backend

[
    %% FIPS mode is enforced via wolfProvider, not Erlang config
    %% To block MD5 at wolfProvider level, configure in openssl.cnf

    {kernel, [
        %% Erlang kernel configuration
        %% Ensure proper network and distributed Erlang settings
        {inet_dist_use_interface, {0,0,0,0}}
    ]},

    {sasl, [
        %% System Application Support Libraries logging
        {sasl_error_logger, false}
    ]}
].
